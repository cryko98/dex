# Robinhood Chain network settings used by the web app.
# Fill these in with the values published for the network you are targeting.
VITE_CHAIN_ID=
VITE_CHAIN_NAME=Robinhood Chain
VITE_RPC_URL=
VITE_EXPLORER_NAME=Robinhood Explorer
VITE_EXPLORER_URL=
VITE_NATIVE_SYMBOL=ETH
VITE_NATIVE_NAME=Ether
VITE_NATIVE_DECIMALS=18

# Set to "true" to also expose the local Hardhat chain (31337) in the network picker.
VITE_ENABLE_LOCALHOST=true
