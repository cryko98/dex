# Network. The app ships with Robinhood Chain mainnet (4663) and testnet (46630)
# built in; nothing here is required to run it.

# Reads go through the same-origin proxy (/api/rpc/<chain>) by default. Set these to
# read a specific endpoint directly from the browser instead.
VITE_RPC_URL=
VITE_TESTNET_RPC_URL=

# Network picker: hide the testnet, or add the local Hardhat chain.
VITE_ENABLE_TESTNET=true
VITE_ENABLE_LOCALHOST=false

# Display names for DEX factories the explorer discovers, as a JSON object.
# VITE_DEX_NAMES={"0x8bceaa40b9acdfaedf85adf4ff01f5ad6517937f":"Launchpad"}
VITE_DEX_NAMES=

# Add an extra EVM network (both required; the rest optional).
VITE_CHAIN_ID=
VITE_CUSTOM_RPC_URL=
VITE_CHAIN_NAME=
VITE_EXPLORER_NAME=
VITE_EXPLORER_URL=
VITE_NATIVE_SYMBOL=ETH
VITE_NATIVE_NAME=Ether
VITE_NATIVE_DECIMALS=18
VITE_MULTICALL3=

# --- Vercel (server-side, for api/rpc/[chain].js) ------------------------
# Upstream JSON-RPC for the proxy. Defaults to Robinhood's public endpoints; point
# these at a dedicated provider for higher rate limits.
# RPC_MAINNET_URL=https://robinhood-mainnet.g.alchemy.com/v2/<key>
# RPC_TESTNET_URL=https://robinhood-testnet.g.alchemy.com/v2/<key>
