{
  "name": "rho-dex-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Constant-product AMM contracts for the Robinhood Chain DEX",
  "scripts": {
    "build": "hardhat compile && node scripts/export-abi.js",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:robinhood": "hardhat run scripts/deploy.js --network robinhood",
    "deploy:robinhoodTestnet": "hardhat run scripts/deploy.js --network robinhoodTestnet",
    "seed:local": "hardhat run scripts/seed.js --network localhost",
    "seed:robinhoodTestnet": "hardhat run scripts/seed.js --network robinhoodTestnet",
    "export:abi": "node scripts/export-abi.js",
    "sync:web": "node scripts/sync-web.js",
    "simulate:local": "hardhat run scripts/simulate.js --network localhost",
    "seed:external": "hardhat run scripts/seed-external.js --network localhost",
    "deploy:lens": "hardhat run scripts/deploy-lens.js --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.17"
  }
}
