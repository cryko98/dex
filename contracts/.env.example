# Robinhood Chain mainnet
ROBINHOOD_RPC_URL=
ROBINHOOD_CHAIN_ID=

# Robinhood Chain testnet
ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_TESTNET_CHAIN_ID=

# Deployer key, funded with gas on the target chain. Never commit a real key.
PRIVATE_KEY=

# Canonical wrapped-native token, if the chain already has one.
# Leave empty to deploy the bundled WETH9.
WETH_ADDRESS=

# Who may switch the protocol fee on. Defaults to the deployer.
FEE_TO_SETTER=

# Block explorer API key, for contract verification.
EXPLORER_API_KEY=

REPORT_GAS=false
